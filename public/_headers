# Cloudflare static-assets headers. Applies ONLY to files served by the assets
# layer (/_next/static/*, /icons/*, /sw.js, /manifest.json ...); Worker-rendered
# responses (pages, /api/*) get their headers from lib/security-headers.ts via
# middleware.ts, which is the single source of truth. Keep the values below in
# sync with STATIC_SECURITY_HEADERS in lib/security-headers.ts.
# No CSP here on purpose: a CSP on /sw.js becomes the service worker's own
# policy and would block its network fetches.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
