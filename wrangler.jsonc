{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mena-intel-desk",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-20",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Cache: Cloudflare answers GET/HEAD from its tiered edge cache, honouring the
  // Cache-Control the Worker returns (s-maxage on ISR pages; `private, no-store` on everything
  // that reads cookies), without running the Worker. Concurrent misses for one URL are collapsed
  // into a single Worker run. No KV/R2 involved. Requires wrangler >= 4.69.
  // Cloudflare ignores the stale-while-revalidate that Next appends when s-maxage is present: an
  // expired page is re-rendered on the next request (that request waits), never served stale.
  // FREE-PLAN NOTE: with this on, static-asset requests also count toward the 100,000
  // requests/day Workers Free limit (see PR body). Set to false to roll back.
  // Deploy skew (incident 2026-10-08): the Worker version is part of the cache key by default,
  // yet /warroom HTML rendered by the previous version was cached 5 s after a deploy and then
  // served with chunk URLs the new version's assets no longer had. Guards: deploy.yml purges this
  // cache after `wrangler deploy` (POST /api/internal/cache-purge -> ctx.cache.purge) and checks
  // every page's assets; app/layout.tsx caps HTML TTL (revalidate) and ships a one-shot
  // cache-busting reload for failed /_next/static loads (lib/stale-build-recovery.ts).
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mena-intel-desk"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://qmaszkkyukgiludcakjg.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_jgm9epohpvCavP6zr4pcig_t3E5mvup",
    "NEXT_PUBLIC_SITE_URL": "https://mena-intel-desk.mores-cohorts9x.workers.dev/"
  }
}
